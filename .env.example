# From `npx cdk deploy` outputs in backend/
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Read ONCE from the Cognito console (App clients -> show client secret).
# Deliberately not a CDK output: anything CDK prints lands in CloudFormation,
# readable by anyone with console access.
COGNITO_CLIENT_SECRET=

AWS_REGION=us-east-1

# The same API the phone talks to.
LISA_API_BASE_URL=https://rt7l0h05y9.execute-api.us-east-1.amazonaws.com
LISA_API_KEY=

# The lisa-voice-api base URL, printed by `npx cdk deploy` in backend/ as
# VoiceApiBaseUrl. The portal calls /caregiver/* on it with the signed-in
# caregiver's Cognito ID token.
LISA_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Stripe secret key (sk_test_... or sk_live_...) from the Stripe dashboard's
# Developers -> API keys. Used only to save a payment method at signup
# (Checkout in 'setup' mode, nothing charged) — no product/price needed for
# that step. STRIPE_PRICE_ID is for later, once LISA-CIRCLE-001's backend
# creates the actual trial subscription at senior-connect time; not read by
# this app yet.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
